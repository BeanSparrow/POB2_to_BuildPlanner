# Copy this file to `.env` and edit POE2_BUILD_DIR to point at the in-game
# Build Planner directory. The PoE2 File Watcher reads .build files from here.
#
# Windows default:
POE2_BUILD_DIR=C:/Users/Your Name/Documents/My Games/Path of Exile 2/BuildPlanner

# SteamOS default (uncomment and adjust if applicable):
# POE2_BUILD_DIR=/home/deck/.local/share/Steam/steamapps/compatdata/2315204395/pfx/drive_c/users/steamuser/Documents/My Games/Path of Exile 2/BuildPlanner
